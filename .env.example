# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real API keys.

# --- Required: data source API keys -----------------------------------
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENAQ_API_KEY=your_openaq_api_key_here

# --- Feature store: Hopsworks (default) -------------------------------
# Get a free API key at https://app.hopsworks.ai (Account Settings -> API Keys)
# Leave HOPSWORKS_API_KEY blank to automatically fall back to the local
# Parquet feature store (set USE_HOPSWORKS=false to skip Hopsworks entirely).
USE_HOPSWORKS=true
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT_NAME=
HOPSWORKS_HOST=
HOPSWORKS_FEATURE_GROUP_NAME=aqi_features
HOPSWORKS_FEATURE_GROUP_VERSION=1
