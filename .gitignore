# Large / generated data & models are versioned deliberately by the
# feature + training GitHub Actions workflows, so they are NOT ignored:
# data/features/*.parquet
# models/*.joblib
# models/*.keras
# models/registry.json
#
# Raw scratch data and local demo artifacts ARE ignored:
data/raw/*.csv
data/processed/*
!data/processed/.gitkeep
